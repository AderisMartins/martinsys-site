---
const whatsappNumber = '5547989248045';
const whatsappLink = `https://wa.me/${whatsappNumber}?text=${encodeURIComponent(
	'Olá, Martinsys! Quero saber mais sobre seus serviços.'
)}`;
const email = 'aderismartins.f@gmail.com';

const navLinks = [
	{ href: '#servicos', label: 'Serviços' },
	{ href: '#produtos', label: 'Produtos' },
	{ href: '#sobre', label: 'Sobre' },
	{ href: '#contato', label: 'Contato' },
];
---

<!doctype html>
<html lang="pt-BR">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href={import.meta.env.BASE_URL + 'favicon.svg'} />
		<meta name="viewport" content="width=device-width" />
		<meta
			name="description"
			content="Martinsys — desenvolvimento de software sob medida, criação de sites, aplicativos mobile e consultoria de IA. Soluções digitais de ponta a ponta para o seu negócio."
		/>
		<meta name="generator" content={Astro.generator} />
		<title>Martinsys | Software sob medida, sites, apps e consultoria de IA</title>
	</head>
	<body>
		<a class="skip-link" href="#conteudo">Pular para o conteúdo</a>

		<header class="site-header">
			<div class="container header-inner">
				<a class="brand" href="#inicio" aria-label="Martinsys — voltar ao início">
					<svg viewBox="0 0 32 32" width="28" height="28" aria-hidden="true">
						<path
							d="M5 26V6l11 14L27 6v20"
							fill="none"
							stroke="url(#brand-grad)"
							stroke-width="4"
							stroke-linecap="round"
							stroke-linejoin="round"
						/>
						<defs>
							<linearGradient id="brand-grad" x1="0" y1="0" x2="32" y2="32" gradientUnits="userSpaceOnUse">
								<stop stop-color="#4da3ff" />
								<stop offset="1" stop-color="#8b5cf6" />
							</linearGradient>
						</defs>
					</svg>
					<span>Martinsys</span>
				</a>

				<nav class="main-nav" aria-label="Navegação principal">
					<button
						class="menu-toggle"
						type="button"
						aria-expanded="false"
						aria-controls="menu-links"
						aria-label="Abrir menu de navegação"
					>
						<span class="menu-bar"></span>
						<span class="menu-bar"></span>
						<span class="menu-bar"></span>
					</button>
					<ul id="menu-links" class="menu-links">
						{navLinks.map((link) => <li><a href={link.href}>{link.label}</a></li>)}
					</ul>
				</nav>
			</div>
		</header>

		<main id="conteudo">
			<section id="inicio" class="hero">
				<div class="hero-bg" aria-hidden="true"></div>
				<div class="container hero-inner">
					<p class="eyebrow">Desenvolvimento de software · Sites · Apps · IA</p>
					<h1>Tecnologia sob medida para o crescimento do seu negócio</h1>
					<p class="hero-sub">
						A Martinsys cria software, sites, aplicativos mobile e soluções de IA que
						geram resultado real. Do planejamento à implementação, tudo em um só lugar.
					</p>
					<div class="hero-cta">
						<a class="btn btn-primary" href={whatsappLink} target="_blank" rel="noopener">
							<svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
								<path
									fill="currentColor"
									d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2 22l5.25-1.38a9.9 9.9 0 0 0 4.79 1.22h.01c5.46 0 9.9-4.45 9.9-9.91C21.95 6.45 17.5 2 12.04 2m5.82 14.13c-.25.7-1.45 1.33-2.02 1.42-.52.08-1.17.11-1.89-.12-.43-.13-.99-.32-1.7-.63-3-1.29-4.95-4.31-5.1-4.51-.15-.2-1.22-1.63-1.22-3.11 0-1.48.78-2.21 1.05-2.51.28-.3.61-.38.81-.38h.58c.19 0 .44-.07.69.53.25.6.85 2.08.93 2.23.07.15.12.33.02.53-.1.2-.15.32-.3.5-.15.17-.31.39-.44.52-.15.15-.31.32-.13.62.17.3.78 1.28 1.67 2.07 1.15 1.02 2.11 1.34 2.41 1.49.3.15.47.13.65-.08.17-.2.75-.87.95-1.17.2-.3.4-.25.67-.15.28.1 1.75.83 2.05.98.3.15.5.22.57.35.08.12.08.7-.17 1.4"
								/>
							</svg>
							Falar no WhatsApp
						</a>
						<a class="btn btn-secondary" href="#servicos">Conhecer os serviços</a>
					</div>
				</div>
			</section>

			<section id="servicos" class="section">
				<div class="container">
					<p class="eyebrow">O que fazemos</p>
					<h2 class="section-title">Soluções digitais de ponta a ponta</h2>
					<p class="section-sub">
						Cada projeto é desenhado para o seu contexto — tecnologia aplicada a um
						objetivo claro.
					</p>

					<div class="card-grid">
						<article class="card">
							<div class="card-icon" aria-hidden="true">
								<svg viewBox="0 0 24 24" width="26" height="26">
									<path
										fill="none"
										stroke="currentColor"
										stroke-width="1.8"
										stroke-linecap="round"
										stroke-linejoin="round"
										d="M8 9l-4 3 4 3M16 9l4 3-4 3M13 6l-2 12"
									/>
								</svg>
							</div>
							<h3>Software sob medida</h3>
							<p>
								Sistemas, integrações e automações desenvolvidos para o seu processo —
								sem se adaptar às limitações de soluções de prateleira.
							</p>
						</article>

						<article class="card">
							<div class="card-icon" aria-hidden="true">
								<svg viewBox="0 0 24 24" width="26" height="26">
									<path
										fill="none"
										stroke="currentColor"
										stroke-width="1.8"
										stroke-linecap="round"
										stroke-linejoin="round"
										d="M3.5 5.5h17v13h-17zM3.5 9.5h17M7 16h4"
									/>
								</svg>
							</div>
							<h3>Criação de sites</h3>
							<p>
								Sites institucionais, landing pages e portais rápidos, responsivos e
								otimizados para conversão e performance.
							</p>
						</article>

						<article class="card">
							<div class="card-icon" aria-hidden="true">
								<svg viewBox="0 0 24 24" width="26" height="26">
									<path
										fill="none"
										stroke="currentColor"
										stroke-width="1.8"
										stroke-linecap="round"
										stroke-linejoin="round"
										d="M12 18.5h.01M10 4h4M5 8a3 3 0 0 1 3-3h8a3 3 0 0 1 3 3v8a3 3 0 0 1-3 3H8a3 3 0 0 1-3-3z"
									/>
								</svg>
							</div>
							<h3>Aplicativos mobile</h3>
							<p>
								Apps para Android e iOS desenvolvidos do conceito à publicação nas
								lojas, com experiência pensada para o usuário.
							</p>
						</article>

						<article class="card">
							<div class="card-icon" aria-hidden="true">
								<svg viewBox="0 0 24 24" width="26" height="26">
									<path
										fill="none"
										stroke="currentColor"
										stroke-width="1.8"
										stroke-linecap="round"
										stroke-linejoin="round"
										d="M12 3a4 4 0 0 1 4 4c0 1.5-.8 2.6-1 3-.7 1.6.3 3 1.5 3.8 1.4.9 2.5 2.2 2.5 4.2v2H5v-2c0-2 1.1-3.3 2.5-4.2 1.2-.8 2.2-2.2 1.5-3.8-.2-.4-1-1.5-1-3a4 4 0 0 1 4-4M8.5 20a3.5 3.5 0 0 0 7 0"
									/>
								</svg>
							</div>
							<h3>Consultoria de IA</h3>
							<p>
								Ajudamos sua empresa a implementar inteligência artificial nas áreas
								certas: estratégia, integração e uso responsável.
							</p>
						</article>
					</div>
				</div>
			</section>

			<section id="produtos" class="section section-alt">
				<div class="container product-grid">
					<div class="product-visual" aria-hidden="true">
						<div class="product-window">
							<div class="window-bar">
								<span></span><span></span><span></span>
							</div>
							<div class="window-body">
								<p class="win-stat-label">Contratos ativos</p>
								<p class="win-stat">128</p>
								<div class="win-rows">
									<div class="win-row">
										<span class="win-pill win-pill-ok">Renova em 12 dias</span>
										<span class="win-tag">Fornecedor</span>
									</div>
									<div class="win-row">
										<span class="win-pill win-pill-warn">Vence em 5 dias</span>
										<span class="win-tag">Locação</span>
									</div>
									<div class="win-row">
										<span class="win-pill win-pill-ai">IA · resumo</span>
										<span class="win-tag">Cláusulas OK</span>
									</div>
								</div>
							</div>
						</div>
					</div>

					<div class="product-info">
						<div class="product-badge">Produto em destaque</div>
						<h2 class="section-title">Contratos IA<span class="tm">·</span></h2>
						<p class="section-sub">
							Sistema de gestão de contratos com inteligência artificial.
						</p>
						<p>
							A IA da Martinsys centraliza seus contratos, extrai cláusulas e prazos
							automaticamente, sinaliza riscos e renovações e reduz drasticamente o
							tempo gasto com administração manual.
						</p>
						<ul class="feature-list">
							<li>Extração automática de cláusulas e prazos</li>
							<li>Alertas de vencimento e renovação</li>
							<li>IA para consulta e revisão de riscos</li>
							<li>Visão consolidada do seu portfólio de contratos</li>
						</ul>
						<div class="hero-cta">
							<a class="btn btn-primary" href={whatsappLink} target="_blank" rel="noopener">
								Quero uma demonstração
							</a>
							<a class="btn btn-secondary" href={`mailto:${email}`}>Falar por e-mail</a>
						</div>
					</div>
				</div>
			</section>

			<section id="sobre" class="section">
				<div class="container about-grid">
					<div class="about-text">
						<p class="eyebrow">Sobre a Martinsys</p>
						<h2 class="section-title">Engenharia de software e IA de mãos dadas</h2>
						<p>
							A Martinsys une desenvolvimento de software e inteligência artificial para
							entregar soluções digitais de ponta a ponta. Trabalhamos lado a lado com
							nossos clientes — de novas empresas a organizações consolidadas — para
							transformar objetivos de negócio em tecnologia que funciona.
						</p>
					</div>
					<div class="diffs">
						<div class="diff">
							<div class="card-icon dif-icon" aria-hidden="true">
								<svg viewBox="0 0 24 24" width="22" height="22">
									<path
										fill="none"
										stroke="currentColor"
										stroke-width="1.8"
										stroke-linecap="round"
										stroke-linejoin="round"
										d="M5 13a1 1 0 1 0 0-2 1 1 0 0 0 0 2M12 13a1 1 0 1 0 0-2 1 1 0 0 0 0 2M19 13a1 1 0 1 0 0-2 1 1 0 0 0 0 2M8 8h8M8 16h8"
									/>
								</svg>
							</div>
							<div>
								<h3>Soluções sob medida</h3>
								<p>Cada projeto começa pelo seu problema, não por um produto pronto.</p>
							</div>
						</div>
						<div class="diff">
							<div class="card-icon dif-icon" aria-hidden="true">
								<svg viewBox="0 0 24 24" width="22" height="22">
									<path
										fill="none"
										stroke="currentColor"
										stroke-width="1.8"
										stroke-linecap="round"
										stroke-linejoin="round"
										d="M17 20v-1a4 4 0 0 0-4-4H7a4 4 0 0 0-4 4v1M10 12a4 4 0 1 0 0-8 4 4 0 0 0 0 8M21 20v-1a4 4 0 0 0-3-3.9M15 4.1a4 4 0 0 1 0 7.8"
									/>
								</svg>
							</div>
							<div>
								<h3>Equipe técnica completa</h3>
								<p>Desenvolvimento, design e IA no mesmo lugar, de ponta a ponta.</p>
							</div>
						</div>
						<div class="diff">
							<div class="card-icon dif-icon" aria-hidden="true">
								<svg viewBox="0 0 24 24" width="22" height="22">
									<path
										fill="none"
										stroke="currentColor"
										stroke-width="1.8"
										stroke-linecap="round"
										stroke-linejoin="round"
										d="M3 17l6-6 4 4 8-8M14 7h7v7"
									/>
								</svg>
							</div>
							<div>
								<h3>Foco em resultado</h3>
								<p>Entregas pensadas para gerar valor: mais eficiência, mais conversão.</p>
							</div>
						</div>
						<div class="diff">
							<div class="card-icon dif-icon" aria-hidden="true">
								<svg viewBox="0 0 24 24" width="22" height="22">
									<path
										fill="none"
										stroke="currentColor"
										stroke-width="1.8"
										stroke-linecap="round"
										stroke-linejoin="round"
										d="M8 10h8m-8 4h5M10 4a6 6 0 1 0 0 12h.6l4 4-1-4.2A6 6 0 0 0 10 4z"
									/>
								</svg>
							</div>
							<div>
								<h3>Parceria próxima</h3>
								<p>Comunicação direta e atendimento humanizado, do início ao fim.</p>
							</div>
						</div>
					</div>
				</div>
			</section>

			<section id="contato" class="section section-alt">
				<div class="container contact-box">
					<p class="eyebrow">Contato</p>
					<h2 class="section-title">Vamos construir algo juntos?</h2>
					<p class="section-sub">
						Conte o seu desafio e receba uma proposta alinhada ao seu objetivo. Respostas
						rápidas pelo WhatsApp ou e-mail.
					</p>

					<div class="contact-actions">
						<a class="btn btn-primary" href={whatsappLink} target="_blank" rel="noopener">
							<svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
								<path
									fill="currentColor"
									d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2 22l5.25-1.38a9.9 9.9 0 0 0 4.79 1.22h.01c5.46 0 9.9-4.45 9.9-9.91C21.95 6.45 17.5 2 12.04 2m5.82 14.13c-.25.7-1.45 1.33-2.02 1.42-.52.08-1.17.11-1.89-.12-.43-.13-.99-.32-1.7-.63-3-1.29-4.95-4.31-5.1-4.51-.15-.2-1.22-1.63-1.22-3.11 0-1.48.78-2.21 1.05-2.51.28-.3.61-.38.81-.38h.58c.19 0 .44-.07.69.53.25.6.85 2.08.93 2.23.07.15.12.33.02.53-.1.2-.15.32-.3.5-.15.17-.31.39-.44.52-.15.15-.31.32-.13.62.17.3.78 1.28 1.67 2.07 1.15 1.02 2.11 1.34 2.41 1.49.3.15.47.13.65-.08.17-.2.75-.87.95-1.17.2-.3.4-.25.67-.15.28.1 1.75.83 2.05.98.3.15.5.22.57.35.08.12.08.7-.17 1.4"
								/>
							</svg>
							WhatsApp: 47 98924-8045
						</a>
						<a class="btn btn-secondary" href={`mailto:${email}`}>
							<svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
								<path
									fill="none"
									stroke="currentColor"
									stroke-width="1.8"
									stroke-linecap="round"
									stroke-linejoin="round"
									d="M4 5h16v14H4zM4 7l8 6 8-6"
								/>
							</svg>
							aderismartins.f@gmail.com
						</a>
					</div>
				</div>
			</section>
		</main>

		<footer class="site-footer">
			<div class="container footer-inner">
				<p>&copy; 2026 Martinsys. Todos os direitos reservados.</p>
				<nav class="footer-nav" aria-label="Menu do rodapé">
					<a href="#servicos">Serviços</a>
					<a href="#produtos">Produtos</a>
					<a href="#sobre">Sobre</a>
					<a href="#contato">Contato</a>
				</nav>
			</div>
		</footer>

		<script>
			const toggle = document.querySelector('.menu-toggle');
			const links = document.querySelector('.menu-links');
			if (toggle && links) {
				toggle.addEventListener('click', () => {
					const open = toggle.getAttribute('aria-expanded') === 'true';
					toggle.setAttribute('aria-expanded', String(!open));
					links.classList.toggle('menu-open', !open);
					toggle.setAttribute('aria-label', (open ? 'Abrir' : 'Fechar') + ' menu de navegação');
				});
				links.addEventListener('click', (ev) => {
					if (ev.target instanceof HTMLAnchorElement && window.innerWidth <= 760) {
						toggle.setAttribute('aria-expanded', 'false');
						links.classList.remove('menu-open');
					}
				});
			}
		</script>

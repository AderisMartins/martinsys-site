---
import Layout from '../layouts/Layout.astro';

const title = 'Martinsys | Engenharia de software e IA para empresas';
const description =
	'Transformamos processos complexos em software inteligente, automatizado e mensurável. Engenharia, automação e IA (RAG, agentes, document AI) aplicadas ao seu negócio.';

const whatsappNumber = '5547989248045';
const whatsappLink = `https://wa.me/${whatsappNumber}?text=${encodeURIComponent(
	'Olá, Martinsys! Quero saber mais sobre o Contratos IA.'
)}`;
const email = 'aderismartins.f@gmail.com';
const base = import.meta.env.BASE_URL;

const methodSteps = [
	{
		icon: 'M9 5H7a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2v-6M9 15l3-3 3 3M12 6l3-3 3 3',
		title: 'Descoberta',
		text: 'Entendemos o processo e o problema real do seu negócio, com os dados que importam em mãos.',
	},
	{
		icon: 'M4 6h16M4 12h16M4 18h16M7 3v4M12 3v4M17 3v4',
		title: 'Arquitetura',
		text: 'Desenhamos a solução técnica adequada — simples quando basta, robusta quando precisa.',
	},
	{
		icon: 'M12 2v6m0 0a4 4 0 0 1 4 4h0m-4-4a4 4 0 0 0-4 4h0m4-4V2m8 6a8 8 0 1 1-16 0',
		title: 'MVP',
		text: 'Primeira versão funcional do pipeline de processamento, pronta para validar com o cliente.',
	},
	{
		icon: 'M8 9l-4 3 4 3M16 9l4 3-4 3M13 6l-2 12',
		title: 'Inteligência',
		text: 'Automação, RAG, agentes e IA aplicada somente onde fazem sentido — sem exageros.',
	},
	{
		icon: 'M12 8v4l3 3m6-3a9 9 0 1 1-3.5-7.1M12 3a9 9 0 0 0 0 18',
		title: 'Evolução',
		text: 'Monitoramos, medimos resultados e evoluímos a solução continuamente.',
	},
];

const capabilities = [
	{
		icon: 'M12 8a3 3 0 1 0-3-3 3 3 0 0 0 3 3Zm0 0v5m0 0a5 5 0 0 1 5 5m-5-5a5 5 0 0 0-5 5',
		title: 'RAG',
		text: 'IA conectada ao conhecimento real da empresa. Respostas com fonte, sem alucinações sobre documentos internos.',
	},
	{
		icon: 'M13 2L5.5 13.5H11l-1.5 8.5L17 10.5h-5.5L13 2Z',
		title: 'Agentes',
		text: 'Sistemas que executam tarefas e tomam ações dentro de fluxos controlados e auditáveis.',
	},
	{
		icon: 'M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8l-6-6Z M14 2v6h6M9 13l2 2 4-4',
		title: 'Document AI',
		text: 'Extração e interpretação de informações em PDFs, contratos e documentos digitalizados.',
	},
	{
		icon: 'M12 15a3 3 0 1 0 0-6 3 3 0 0 0 0 6Zm7-3a7 7 0 0 1-14 0m14 0a7 7 0 0 0-14 0',
		title: 'Automação inteligente',
		text: 'Processos manuais transformados em workflows automatizados, rastreáveis e mensuráveis.',
	},
	{
		icon: 'M4 14v-4a8 8 0 0 1 16 0v4M4 14a2 2 0 0 1 2 2v3a2 2 0 0 1-2 2h-.5A2 2 0 0 1 2 17v-2a1 1 0 0 1 1-1h1Zm16 0a2 2 0 0 0-2 2v3a2 2 0 0 0 2 2h.5a2 2 0 0 0 2-2v-2a1 1 0 0 0-1-1h-1.5Z',
		title: 'IA local',
		text: 'Quando segurança e privacidade importam, avaliamos modelos em infraestrutura própria.',
	},
	{
		icon: 'M10 13a5 5 0 0 0 7.5.5l3-3a5 5 0 0 0-7.07-7.07l-1.7 1.7M14 11a5 5 0 0 0-7.5-.5l-3 3a5 5 0 0 0 7.07 7.07l1.7-1.7',
		title: 'Integrações',
		text: 'IA conectada aos sistemas que a empresa já utiliza, sem reinventar a roda.',
	},
];

const architectureFlow = [
	{ group: 'Entradas', items: ['Documentos', 'OCR', 'SQL/APIs'] },
	{ group: 'Inteligência', items: ['RAG', 'Agentes', 'Embeddings'] },
	{ group: 'Rodada por', items: ['AI Gateway', 'LLMs', 'Ollama (local)'] },
	{ group: 'Base', items: ['Java/Spring Boot', 'Python', 'Go'] },
	{ group: 'Dados', items: ['PostgreSQL', 'pgvector', 'RabbitMQ'] },
	{ group: 'Entrega', items: ['Docker', 'Kubernetes', 'CI/CD'] },
];

const securityItems = [
	{ icon: 'M12 2l8 4v6c0 5-3.5 8.5-8 10-4.5-1.5-8-5-8-10V6l8-4Z', title: 'Criptografia', text: 'Dados protegidos em trânsito e em repouso.' },
	{ icon: 'M3 7h18v11a3 3 0 0 1-3 3H6a3 3 0 0 1-3-3V7Zm9 4v6m-3-2h6', title: 'Controle por organização', text: 'Acesso isolado e auditável por cliente.' },
	{ icon: 'M3 6h18v13H3V6Zm6 7h6m-6-4h6M3 3h18v3H3V3Z', title: 'Logs e auditoria', text: 'Toda ação registrada para rastreio completo.' },
	{ icon: 'M5 19V7a7 7 0 0 1 14 0v12M5 19h14M2 19h20', title: 'Backup', text: 'Cópias regulares com recuperação testada.' },
];
---

<Layout title={title} description={description} page="home">
	<section class="hero">
		<div class="hero-bg" aria-hidden="true"></div>
		<div class="container hero-inner">
			<div class="hero-copy">
				<p class="eyebrow">
					<span class="eyebrow-dot" aria-hidden="true"></span>
					Engenharia de software · IA aplicada
				</p>
				<h1>
					Software inteligente para transformar processos complexos em
					<span class="grad-text">resultados reais.</span>
				</h1>
				<p class="hero-sub">
					A Martinsys combina engenharia, automação e inteligência artificial para criar sistemas que
					leem documentos, automatizam tarefas e ajudam sua empresa a decidir melhor.
				</p>
				<div class="hero-cta">
					<a class="btn btn-primary btn-lg" href={`${base}contratos-ia/`}>
						Conhecer o Contratos IA
						<svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
							<path fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" d="M5 12h14m-6-6 6 6-6 6" />
						</svg>
					</a>
					<a class="btn btn-secondary btn-lg" href={whatsappLink} target="_blank" rel="noopener">
						Falar com um especialista
					</a>
				</div>
				<ul class="hero-trust" aria-label="Diferenciais">
					<li>Automação de ponta a ponta</li>
					<li>IA com fonte verificável</li>
					<li>Entrega medida por resultado</li>
				</ul>
			</div>

			<div class="hero-visual" aria-hidden="true">
				<div class="app-window">
					<div class="window-bar">
						<span></span>
						<span></span>
						<span></span>
						<div class="window-title">Contratos IA · visão geral</div>
					</div>
					<div class="window-body">
						<div class="win-stats">
							<div class="win-stat">
								<span class="win-stat-value">1.284</span>
								<span class="win-stat-label">Contratos analisados</span>
							</div>
							<div class="win-stat">
								<span class="win-stat-value">47</span>
								<span class="win-stat-label">Renovações próximas</span>
							</div>
							<div class="win-stat">
								<span class="win-stat-value win-stat-warn">23</span>
								<span class="win-stat-label">Alto risco</span>
							</div>
						</div>
						<ul class="win-risks">
							<li>
								<span class="pill pill-warn">ALTO</span>
								<span class="win-risk-text">Renovação automática sem aviso prévio</span>
							</li>
							<li>
								<span class="pill pill-danger">CRÍTICO</span>
								<span class="win-risk-text">Responsabilidade ilimitada · Cláusula 8.2</span>
							</li>
						</ul>
						<div class="win-chat">
							<div class="win-chat-q">Quais riscos valem revisão?</div>
							<div class="win-chat-a">
								Foram identificados 3 pontos: multa não especificada, renovação automática sem aviso e
								limitação de responsabilidade ampla.
							</div>
						</div>
					</div>
				</div>
				<div class="hero-orb hero-orb-1"></div>
				<div class="hero-orb hero-orb-2"></div>
			</div>
		</div>
	</section>

	<section id="problema" class="section section-alt">
		<div class="container">
			<div class="section-head center">
				<p class="eyebrow">O problema</p>
				<h2 class="section-title">
					Processos complexos se perdem em <span class="grad-text">documentos.</span>
				</h2>
				<p class="section-sub">
					Contratos, regulamentações e documentos crescem em volume. A análise manual é lenta, propensa a
					erros e não escala. Prazos são perdidos, riscos ficam escondidos e decisões atrasam.
				</p>
			</div>
			<div class="problem-grid">
				<article class="card problem-card">
					<div class="card-title-row">
						<strong class="problem-no">01</strong>
						<h3>Volume crescente</h3>
					</div>
					<p>O acervo de documentos dobra enquanto a equipe continua a mesma.</p>
				</article>
				<article class="card problem-card">
					<div class="card-title-row">
						<strong class="problem-no">02</strong>
						<h3>Análise manual</h3>
					</div>
					<p>Horas de leitura repetida para extrair cláusulas, prazos e obrigações.</p>
				</article>
				<article class="card problem-card">
					<div class="card-title-row">
						<strong class="problem-no">03</strong>
						<h3>Riscos invisíveis</h3>
					</div>
					<p>Multas, renovações automáticas e responsabilidades passam despercebidas.</p>
				</article>
			</div>
		</div>
	</section>

	<section id="como-trabalhamos" class="section">
		<div class="container">
			<div class="section-head">
				<p class="eyebrow">Como trabalhamos</p>
				<h2 class="section-title">Do problema à solução inteligente</h2>
				<p class="section-sub">Um caminho enxuto, guiado por resultado e não por tecnologia.</p>
			</div>
			<div class="method-grid">
				{methodSteps.map((step) => (
					<article class="card method-card">
						<span class="method-no">{'0' + (methodSteps.indexOf(step) + 1)}</span>
						<div class="card-icon" aria-hidden="true">
							<svg viewBox="0 0 24 24" width="24" height="24">
								<path fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" d={step.icon} />
							</svg>
						</div>
						<h3>{step.title}</h3>
						<p>{step.text}</p>
					</article>
				))}
			</div>
		</div>
	</section>

	<section id="contratos-ia" class="section section-alt">
		<div class="container">
			<div class="split-band">
				<div class="split-copy">
					<p class="eyebrow">Produto em destaque</p>
					<h2 class="section-title">
						Seus contratos escondem informações importantes. <span class="grad-text">A IA encontra.</span>
					</h2>
					<p class="section-sub">
						O Contratos IA transforma documentos complexos em informações estruturadas, riscos, obrigações,
						prazos e respostas acionáveis — cada dado com fonte, página e cláusula.
					</p>
				</div>
				<div class="split-actions">
					<a class="btn btn-primary btn-lg" href={`${base}contratos-ia/`}>Ver demonstração</a>
					<a class="btn btn-secondary btn-lg" href={whatsappLink} target="_blank" rel="noopener">
						Falar com um especialista
					</a>
				</div>
			</div>
		</div>
	</section>

	<section id="capacidades" class="section">
		<div class="container">
			<div class="section-head center">
				<p class="eyebrow">Capacidades de IA</p>
				<h2 class="section-title">IA que trabalha com seus dados</h2>
				<p class="section-sub">
					Soluções que interpretam documentos, consultam conhecimento interno, encontram padrões e integram
					inteligência diretamente aos processos da empresa.
				</p>
			</div>
			<div class="cap-grid">
				{capabilities.map((cap) => (
					<article class="card cap-card">
						<div class="card-icon" aria-hidden="true">
							<svg viewBox="0 0 24 24" width="24" height="24">
								<path fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" d={cap.icon} />
							</svg>
						</div>
						<h3>{cap.title}</h3>
						<p>{cap.text}</p>
					</article>
				))}
			</div>
		</div>
	</section>

	<section id="cases" class="section section-alt">
		<div class="container">
			<div class="section-head">
				<p class="eyebrow">Case real</p>
				<h2 class="section-title">Tecnologia aplicada a um problema real</h2>
			</div>
			<div class="card case-card">
				<div class="case-grid">
					<div class="case-block">
						<h3>Problema</h3>
						<p>Grande volume de contratos com análise 100% manual, prazos e riscos escondidos.</p>
					</div>
					<div class="case-block">
						<h3>Solução</h3>
						<p>Pipeline de ingestão + extração + RAG + análise de riscos com citações verificáveis.</p>
					</div>
					<div class="case-block">
						<h3>Tecnologias</h3>
						<p>Java · Python · PostgreSQL · pgvector · RabbitMQ · LLMs</p>
					</div>
					<div class="case-block">
						<h3>Resultado</h3>
						<p>Informações estruturadas e pesquisáveis a partir de documentos brutos.</p>
					</div>
				</div>
			</div>
		</div>
	</section>

	<section id="arquitetura" class="section">
		<div class="container">
			<div class="section-head center">
				<p class="eyebrow">Arquitetura e tecnologia</p>
				<h2 class="section-title">Uma base sólida por trás da inteligência</h2>
				<p class="section-sub">Tecnologias apresentadas apenas quando são realmente usadas na solução.</p>
			</div>
			<div class="arch-flow">
				{architectureFlow.map((node) => (
					<div class="arch-node">
						<div class="arch-node-label">{node.group}</div>
						<div class="arch-chips">
							{node.items.map((item) => (
								<span class="chip">{item}</span>
							))}
						</div>
					</div>
				))}
			</div>
		</div>
	</section>

	<section id="seguranca" class="section section-alt">
		<div class="container">
			<div class="section-head">
				<p class="eyebrow">Segurança</p>
				<h2 class="section-title">Seus contratos continuam sendo seus.</h2>
				<p class="section-sub">
					Apresentamos apenas o que é realmente implementado — sem certificações inventadas nem
					reivindicações absolutas.
				</p>
			</div>
			<div class="security-grid">
				{securityItems.map((item) => (
					<article class="card security-card">
						<div class="card-icon" aria-hidden="true">
							<svg viewBox="0 0 24 24" width="24" height="24">
								<path fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" d={item.icon} />
							</svg>
						</div>
						<div>
							<h3>{item.title}</h3>
							<p>{item.text}</p>
						</div>
					</article>
				))}
			</div>
		</div>
	</section>

	<section id="contato" class="section">
		<div class="container">
			<div class="cta-band">
				<p class="eyebrow">Contato</p>
				<h2 class="section-title">Qual processo da sua empresa poderia ser automatizado com IA?</h2>
				<p class="section-sub">
					Conte o problema. A Martinsys ajuda a transformar a ideia em uma solução de software real.
				</p>
				<div class="contact-actions">
					<a class="btn btn-primary btn-lg" href={whatsappLink} target="_blank" rel="noopener">
						Quero conversar no WhatsApp
					</a>
					<a class="btn btn-secondary btn-lg" href={`mailto:${email}`}>Falar por e-mail</a>
				</div>
			</div>
		</div>
	</section>
</Layout>

<style>
	.eyebrow-dot {
		width: 8px;
		height: 8px;
		border-radius: 50%;
		background: var(--grad);
	}

	/* Hero */
	.hero {
		position: relative;
		overflow: hidden;
		padding: 96px 0 104px;
		border-bottom: 1px solid var(--border);
	}

	.hero-bg {
		position: absolute;
		inset: 0;
		background:
			radial-gradient(52% 60% at 16% 8%, rgba(79, 70, 229, 0.14), transparent 72%),
			radial-gradient(44% 56% at 86% 20%, rgba(8, 145, 178, 0.12), transparent 70%),
			linear-gradient(180deg, #f8faff, var(--bg-0) 80%);
		pointer-events: none;
	}

	.hero-bg::after {
		content: '';
		position: absolute;
		inset: 0;
		background-image: linear-gradient(var(--border) 1px, transparent 1px),
			linear-gradient(90deg, var(--border) 1px, transparent 1px);
		background-size: 46px 46px;
		opacity: 0.5;
		-webkit-mask-image: radial-gradient(70% 70% at 50% 0%, #000 30%, transparent 82%);
		mask-image: radial-gradient(70% 70% at 50% 0%, #000 30%, transparent 82%);
	}

	.hero-inner {
		position: relative;
		display: grid;
		grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
		gap: 56px;
		align-items: center;
	}

	.hero-copy h1 {
		font-size: clamp(2.2rem, 5vw, 3.5rem);
		line-height: 1.12;
		letter-spacing: -1px;
		margin-bottom: 22px;
	}

	.hero-sub {
		max-width: 540px;
		color: var(--muted);
		font-size: 1.12rem;
		margin-bottom: 32px;
	}

	.hero-cta {
		display: flex;
		flex-wrap: wrap;
		gap: 14px;
		margin-bottom: 36px;
	}

	.hero-trust {
		list-style: none;
		display: flex;
		flex-wrap: wrap;
		gap: 10px 24px;
		color: var(--ink-2);
		font-size: 0.92rem;
		font-weight: 500;
	}

	.hero-trust li::before {
		content: '✓';
		margin-right: 8px;
		color: var(--ok);
		font-weight: 700;
	}

	/* App window */
	.hero-visual {
		position: relative;
	}

	.app-window {
		position: relative;
		z-index: 2;
		border: 1px solid var(--border);
		border-radius: 20px;
		background: var(--bg-0);
		box-shadow: var(--shadow-md);
		overflow: hidden;
	}

	.window-bar {
		display: flex;
		align-items: center;
		gap: 8px;
		padding: 14px 18px;
		background: var(--bg-1);
		border-bottom: 1px solid var(--border);
	}

	.window-bar span {
		width: 11px;
		height: 11px;
		border-radius: 50%;
		background: var(--border-strong);
	}

	.window-title {
		margin-left: 8px;
		color: var(--muted);
		font-size: 0.8rem;
		font-weight: 500;
	}

	.window-body {
		padding: 24px;
	}

	.win-stats {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 12px;
		margin-bottom: 20px;
	}

	.win-stat {
		display: flex;
		flex-direction: column;
		gap: 2px;
		padding: 14px;
		border: 1px solid var(--border);
		border-radius: 14px;
		background: var(--bg-1);
	}

	.win-stat-value {
		font-size: 1.7rem;
		font-weight: 800;
		letter-spacing: -0.5px;
		background: var(--grad);
		-webkit-background-clip: text;
		background-clip: text;
		color: transparent;
	}

	.win-stat-warn {
		background: none;
		color: var(--warn);
		-webkit-text-fill-color: var(--warn);
	}

	.win-stat-label {
		color: var(--muted);
		font-size: 0.74rem;
		font-weight: 500;
	}

	.win-risks {
		list-style: none;
		display: flex;
		flex-direction: column;
		gap: 10px;
		margin-bottom: 18px;
	}

	.win-risks li {
		display: flex;
		align-items: center;
		gap: 12px;
		padding: 12px 14px;
		border: 1px solid var(--border);
		border-radius: 12px;
	}

	.pill {
		flex-shrink: 0;
		font-size: 0.72rem;
		font-weight: 700;
		letter-spacing: 0.4px;
		padding: 4px 10px;
		border-radius: 999px;
	}

	.pill-warn {
		color: var(--warn);
		background: rgba(217, 119, 6, 0.12);
	}

	.pill-danger {
		color: var(--danger);
		background: rgba(220, 38, 38, 0.1);
	}

	.win-risk-text {
		color: var(--ink-2);
		font-size: 0.86rem;
	}

	.win-chat {
		border: 1px solid var(--border);
		border-radius: 14px;
		overflow: hidden;
	}

	.win-chat-q {
		padding: 12px 16px;
		background: var(--bg-1);
		font-weight: 600;
		font-size: 0.88rem;
	}

	.win-chat-a {
		padding: 12px 16px;
		color: var(--ink-2);
		font-size: 0.86rem;
		border-top: 1px solid var(--border);
	}

	.hero-orb {
		position: absolute;
		z-index: 1;
		border-radius: 50%;
		filter: blur(46px);
		opacity: 0.5;
	}

	.hero-orb-1 {
		width: 180px;
		height: 180px;
		top: -40px;
		right: -30px;
		background: rgba(79, 70, 229, 0.35);
	}


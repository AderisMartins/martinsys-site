---
import Layout from '../layouts/Layout.astro';

const title = 'Contratos IA | Martinsys';
const description =
	'Contratos IA: IA que extrai cláusulas, riscos, obrigações e prazos de documentos jurídicos. Pipeline: upload → ingestão → IA → análise → insights → ação.';

const whatsappNumber = '5547989248045';
const whatsappLink = `https://wa.me/${whatsappNumber}?text=${encodeURIComponent(
	'Olá, Martinsys! Quero conhecer o Contratos IA.'
)}`;
const email = 'aderismartins.f@gmail.com';

const pipeline = [
	{ no: '01', name: 'Upload', text: 'PDF, DOCX ou documento digitalizado' },
	{ no: '02', name: 'Ingestão', text: 'OCR + parsing + normalização' },
	{ no: '03', name: 'IA', text: 'Extração + classificação + RAG' },
	{ no: '04', name: 'Análise', text: 'Riscos + cláusulas + obrigações' },
	{ no: '05', name: 'Insights', text: 'Resumo + alertas + perguntas' },
	{ no: '06', name: 'Ação', text: 'Decisão + acompanhamento + relatório' },
];

const stats = [
	{ value: '1.284', label: 'Contratos' },
	{ value: 'R$ 18,4M', label: 'Valor contratado' },
	{ value: '47', label: 'Renovações próximas' },
	{ value: '23', label: 'Contratos de alto risco' },
	{ value: '186', label: 'Obrigações ativas' },
];

const extractionFields = [
	'Partes',
	'CNPJ',
	'Valores',
	'Datas',
	'Vigência',
	'Renovação',
	'Pagamentos',
	'Multas',
	'Obrigações',
	'Cláusulas',
	'Foro',
	'Responsabilidades',
	'Garantias',
	'Seguros',
	'SLA',
	'Rescisão',
];

const timelineEvents = [
	{ marco: 'Assinatura', data: '15/03/2024', responsavel: 'João Silva', status: 'Concluído', tone: 'ok' },
	{ marco: 'Primeiro pagamento', data: '01/04/2024', responsavel: 'João Silva', status: 'Pago', tone: 'ok' },
	{ marco: 'Aviso prévio', data: '15/12/2025', responsavel: 'Compliance', status: 'Atenção', tone: 'warn' },
	{ marco: 'Renovação', data: '15/03/2026', responsavel: 'Compliance', status: 'Próximo', tone: 'warn' },
];

const comparison = [
	{ item: 'Limitação de responsabilidade', a: 'R$ 50 mil', b: 'R$ 500 mil' },
	{ item: 'Aviso prévio de rescisão', a: '30 dias', b: '90 dias' },
	{ item: 'Renovação', a: 'Automática', b: 'Manual' },
	{ item: 'SLA', a: '99%', b: '99,9%' },
];

const faq = [
	{
		q: 'A IA analisa contratos digitalizados?',
		a: 'Sim, quando a ingestão suportar OCR. A pipeline inclui OCR + parsing + normalização para documentos digitalizados.',
	},
	{
		q: 'Posso perguntar sobre meus contratos?',
		a: 'Sim. O chat/RAG responde sobre os documentos carregados na sua conta, sempre com indicação da fonte.',
	},
	{
		q: 'A IA mostra de onde veio a resposta?',
		a: 'Sim. Cada resposta apresenta fonte, página e cláusula — toda informação importante pode ser verificada no documento original.',
	},
	{
		q: 'Posso acompanhar vencimentos?',
		a: 'Sim. Alerta e linha do tempo contratual com prazos de renovação e vencimento para cada contrato.',
	},
	{
		q: 'Meus dados ficam isolados?',
		a: 'Sim. Controle de acesso por organização e segregação por sistema. Não inventamos certificações.',
	},
	{
		q: 'Posso integrar com outros sistemas?',
		a: 'Quando disponível, via API e integradores. A arquitetura contempla conexão com sistemas corporativos existentes.',
	},
	{
		q: 'Posso utilizar IA local?',
		a: 'Depende do projeto. Avaliamos arquiteturas com modelos em infraestrutura própria quando segurança ou privacidade exigirem.',
	},
	{
		q: 'A IA substitui a análise jurídica?',
		a: 'Não. O sistema apoia a análise e a tomada de decisão, mas não substitui aconselhamento jurídico profissional.',
	},
];

const securityNotes = [
	'Criptografia em trânsito e em repouso',
	'Controle de acesso por organização',
	'Logs e trilha de auditoria',
	'Backup e recuperação testados',
	'Segregação entre organizações',
];
---

<Layout title={title} description={description} page="produto">
	<section class="hero">
		<div class="hero-bg" aria-hidden="true"></div>
		<div class="container hero-inner">
			<div class="hero-copy">
				<p class="eyebrow">
					<span class="eyebrow-dot" aria-hidden="true"></span>
					Produto · Document AI
				</p>
				<h1>
					Seus contratos escondem informações importantes.
					<span class="grad-text">A IA encontra.</span>
				</h1>
				<p class="hero-sub">
					O Contratos IA transforma documentos complexos em informações estruturadas, riscos, obrigações,
					prazos e respostas acionáveis.
				</p>
				<div class="hero-cta">
					<a class="btn btn-primary btn-lg" href={`mailto:${email}`}>
						Solicitar demonstração
					</a>
					<a class="btn btn-secondary btn-lg" href={whatsappLink} target="_blank" rel="noopener">
						Falar com um especialista
					</a>
				</div>
				<ul class="hero-trust" aria-label="Como o produto ajuda">
					<li>Cada dado com fonte, página e cláusula</li>
					<li>Respostas verificáveis no documento</li>
					<li>Sem invenções nem promessas absolutas</li>
				</ul>
			</div>

			<div class="hero-visual" aria-hidden="true">
				<div class="app-window">
					<div class="window-bar">
						<span></span>
						<span></span>
						<span></span>
						<div class="window-title">Contratos IA · análise</div>
					</div>
					<div class="window-body">
						<div class="risk-score-box">
							<div class="risk-score-title">Risco geral do contrato</div>
							<div class="risk-score-value">
								<strong>78 / 100</strong>
								<span class="pill pill-danger">ALTO RISCO</span>
							</div>
							<div class="risk-score-bar"><span class="risk-score-fill"></span></div>
						</div>
						<ul class="win-risks">
							<li>
								<span class="pill pill-warn">ALTO</span>
								<span class="win-risk-text">Multa contratual não especificada</span>
							</li>
							<li>
								<span class="pill pill-warn">ALTO</span>
								<span class="win-risk-text">Renovação automática sem aviso prévio</span>
							</li>
							<li>
								<span class="pill pill-danger">CRÍTICO</span>
								<span class="win-risk-text">Limitação de responsabilidade ampla</span>
							</li>
						</ul>
						<div class="win-dates">
							<span>Renovação · 12/09/2026</span>
							<span>Aviso prévio · 28/10/2026</span>
						</div>
						<div class="win-meta">
							<span>12 obrigações identificadas</span>
							<span>Valor: R$ 250.000,00</span>
						</div>
						<div class="win-chat">
							<div class="win-chat-q">Quais são os principais riscos deste contrato?</div>
							<div class="win-chat-a">
								Foram identificados 3 pontos que merecem revisão: multa não especificada, renovação
								automática sem aviso prévio e limitação de responsabilidade ampla.
							</div>
							<div class="win-cite">Fonte: Página 14, Cláusula 8.2 · Confiança 94%</div>
						</div>
					</div>
				</div>
				<div class="hero-orb hero-orb-1"></div>
				<div class="hero-orb hero-orb-2"></div>
			</div>
		</div>
	</section>

	<section id="problema" class="section section-alt">
		<div class="container">
			<div class="section-head center">
				<p class="eyebrow">O problema</p>
				<h2 class="section-title">
					Análise manual é lenta, cara e <span class="grad-text">propensa a erros.</span>
				</h2>
				<p class="section-sub">
					Equipes jurídicas e de compliance gastam horas relendo contratos para extrair cláusulas, prazos e
					riscos. No volume atual, isso não escala: renovações são perdidas, multas passam despercebidas e
					obrigações críticas ficam escondidas entre páginas de texto.
				</p>
			</div>
		</div>
	</section>

	<section id="como-funciona" class="section">
		<div class="container">
			<div class="section-head">
				<p class="eyebrow">Como funciona</p>
				<h2 class="section-title">Do PDF à decisão em segundos</h2>
				<p class="section-sub">Seis etapas encadeadas, cada uma alimentando a próxima.</p>
			</div>
			<ol class="pipeline">
				{pipeline.map((step) => (
					<li class="pipeline-step">
						<span class="pipeline-no">{step.no}</span>
						<div class="pipeline-card">
							<h3>{step.name}</h3>
							<p>{step.text}</p>
						</div>
					</li>
				))}
			</ol>
		</div>
	</section>

	<section id="dashboard" class="section section-alt">
		<div class="container">
			<div class="section-head">
				<p class="eyebrow">Dashboard</p>
				<h2 class="section-title">Visão geral, sem surpresa no fim do mês</h2>
			</div>
			<div class="stats-grid">
				{stats.map((stat) => (
					<article class="card stat-card">
						<div class="stat-value">{stat.value}</div>
						<div class="stat-label">{stat.label}</div>
					</article>
				))}
			</div>
		</div>
	</section>

	<section id="extracao" class="section">
		<div class="container">
			<div class="section-head">
				<p class="eyebrow">Extração inteligente</p>
				<h2 class="section-title">O documento vira campos estruturados</h2>
				<p class="section-sub">
					Cada dado extraído é rastreável: fonte, página e cláusula de origem.
				</p>
			</div>
			<ul class="field-list">
				{extractionFields.map((field) => (
					<li>{field}</li>
				))}
			</ul>
		</div>
	</section>

	<section id="riscos" class="section section-alt">
		<div class="container">
			<div class="section-head">
				<p class="eyebrow">Análise de riscos</p>
				<h2 class="section-title">Riscos explicados, não apenas sinalizados</h2>
				<p class="section-sub">
					Cada risco classificado como crítico, alto, médio ou baixo, com motivos, trecho original, página,
					impacto e recomendação.
				</p>
			</div>
			<div class="risk-list">
				<div class="risk-item">
					<div class="risk-head">
						<span class="pill pill-warn">ALTO</span>
						<strong>Renovação automática</strong>
					</div>
					<p>Sem aviso prévio obrigatório. Impacto: extensão indevida de contrato. Recomendação: inserir aviso de 60 dias.</p>
				</div>
				<div class="risk-item">
					<div class="risk-head">
						<span class="pill pill-danger">CRÍTICO</span>
						<strong>Responsabilidade ilimitada</strong>
					</div>
					<p>Cláusula 8.2, página 14. Impacto: exposição financeira sem teto. Recomendação: definir limite e seguro.</p>
				</div>
			</div>
			<div class="legend">
				<span class="pill pill-ok">BAIXO</span>
				<span class="pill pill-warn-2">MÉDIO</span>
				<span class="pill pill-warn">ALTO</span>
				<span class="pill pill-danger">CRÍTICO</span>
			</div>
		</div>
	</section>

	<section id="chat" class="section">
		<div class="container">
			<div class="section-head center">
				<p class="eyebrow">Chat com contratos</p>
				<h2 class="section-title">"Pergunte aos seus contratos."</h2>
				<p class="section-sub">
					Respostas com fonte, página e cláusula. Exemplo: "O contrato possui renovação automática." — Fonte:
					Página 14, Cláusula 8.2 · Confiança 94%.
				</p>
			</div>
			<div class="chat-grid">
				<div class="chat-example">
					<div class="chat-q">Quais são os principais riscos deste contrato?</div>
					<div class="chat-a">
						Foram identificados 3 pontos que merecem revisão: (1) multa contratual não especificada,
						(2) renovação automática sem aviso prévio, (3) limitação de responsabilidade ampla.
					</div>
					<div class="chat-cite">Fonte verificável no documento original.</div>
				</div>
				<ul class="chat-questions">
					<li>Quais contratos vencem nos próximos 30 dias?</li>
					<li>Quais possuem renovação automática?</li>
					<li>Quais têm multa acima de R$ 100 mil?</li>
					<li>Quais apresentam responsabilidade ilimitada?</li>
					<li>Qual é a obrigação da contratada neste documento?</li>
				</ul>
			</div>
		</div>
	</section>

	<section id="timeline" class="section section-alt">
		<div class="container">
			<div class="section-head">
				<p class="eyebrow">Linha do tempo contratual</p>
				<h2 class="section-title">Cada evento com responsável e status</h2>
				<p class="section-sub">Assinatura, pagamentos, SLA, avisos, renovações e vencimentos em um só lugar.</p>
			</div>
			<ol class="timeline">
				{timelineEvents.map((ev) => (
					<li class="timeline-event">
						<span class="timeline-marco">{ev.marco}</span>
						<span class="timeline-data">{ev.data}</span>
						<span class="timeline-responsavel">{ev.responsavel}</span>
						<span class={`pill ${ev.tone === 'ok' ? 'pill-ok' : 'pill-warn'}`}>{ev.status}</span>
					</li>
				))}
			</ol>
		</div>
	</section>

	<section id="comparacao" class="section">
		<div class="container">
			<div class="section-head">
				<p class="eyebrow">Comparação de contratos</p>
				<h2 class="section-title">Diferenças destacadas com cláusula e página</h2>
			</div>
			<div class="comparison">
				<div class="comparison-head">
					<span></span>
					<span class="comparison-side comparison-a">CONTRATO A</span>
					<span class="comparison-side comparison-b">CONTRATO B</span>
				</div>
				{comparison.map((row) => (
					<div class="comparison-row">
						<span class="comparison-item">{row.item}</span>
						<span class="comparison-a">{row.a}</span>
						<span class="comparison-b">{row.b}</span>
					</div>
				))}
				<div class="comparison-foot">
					A IA destaca as diferenças relevantes e indica a origem em cada contrato.
				</div>
			</div>
		</div>
	</section>

	<section id="relatorios" class="section section-alt">
		<div class="container">
			<div class="split-band">
				<div class="split-copy">
					<p class="eyebrow">Relatórios</p>
					<h2 class="section-title">Relatórios completos de análise contratual</h2>
					<p class="section-sub">
						Resumos com todas as informações extraídas, riscos identificados, prazos e obrigações —
						formatados para revisão jurídica e acompanhamento de portfólio.
					</p>
				</div>
				<div class="split-actions">
					<a class="btn btn-primary btn-lg" href={whatsappLink} target="_blank" rel="noopener">
						Quero conversar
					</a>
					<a class="btn btn-secondary btn-lg" href={`mailto:${email}`}>Falar por e-mail</a>
				</div>
			</div>
		</div>
	</section>

	<section id="seguranca" class="section">
		<div class="container">
			<div class="section-head center">
				<p class="eyebrow">Segurança</p>
				<h2 class="section-title">Seus contratos continuam sendo seus.</h2>
				<p class="section-sub">Implementado de verdade, sem certificações inventadas.</p>
			</div>
			<ul class="security-check-list">
				{securityNotes.map((note) => (
					<li>
						<span class="check" aria-hidden="true">
							<svg viewBox="0 0 24 24" width="14" height="14">
								<path fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4 10-10" />
							</svg>
						</span>
						{note}
					</li>
				))}
			</ul>
		</div>
	</section>

	<section id="arquitetura" class="section section-alt">
		<div class="container">
			<div class="section-head center">
				<p class="eyebrow">Arquitetura por trás da inteligência</p>
				<h2 class="section-title">Arquitetura MARTINSYS AI</h2>
				<p class="section-sub">
					Nomes técnicos aparecem apenas se genuinamente usados no produto: Java/Spring Boot, Python, Go,
					PostgreSQL, pgvector, RabbitMQ, Docker, Kubernetes, Ollama, LLMs.
				</p>
			</div>
			<div class="arch-flow">
				<div class="arch-node arch-node-head">
					<div class="arch-node-label">Núcleo</div>
					<div class="arch-chips">
						<span class="chip chip-brand">MARTINSYS AI</span>
					</div>
				</div>
				<div class="arch-node">
					<div class="arch-node-label">Inteligência</div>
					<div class="arch-chips">
						<span class="chip">Document</span>
						<span class="chip">RAG</span>
						<span class="chip">Agents</span>
					</div>
				</div>
				<div class="arch-node">
					<div class="arch-node-label">Acesso</div>
					<div class="arch-chips">
						<span class="chip">OCR</span>
						<span class="chip">Embeddings</span>
						<span class="chip">Tools</span>
					</div>
				</div>
				<div class="arch-node">
					<div class="arch-node-label">Rodada por</div>
					<div class="arch-chips">
						<span class="chip">AI Gateway</span>
						<span class="chip">Ollama</span>
						<span class="chip">LLMs</span>
					</div>
				</div>
				<div class="arch-node">
					<div class="arch-node-label">Serviços</div>
					<div class="arch-chips">
						<span class="chip">Java/Spring Boot</span>
						<span class="chip">Python</span>
						<span class="chip">Go</span>
					</div>
				</div>
				<div class="arch-node">
					<div class="arch-node-label">Dados</div>
					<div class="arch-chips">
						<span class="chip">PostgreSQL</span>
						<span class="chip">pgvector</span>
						<span class="chip">RabbitMQ</span>
					</div>
				</div>
				<div class="arch-node">
					<div class="arch-node-label">Entrega</div>
					<div class="arch-chips">
						<span class="chip">Docker</span>
						<span class="chip">Kubernetes</span>
					</div>
				</div>
			</div>
		</div>
	</section>

	<section id="ia-local" class="section">
		<div class="container">
			<div class="section-head">
				<p class="eyebrow">IA na nuvem ou na sua infraestrutura</p>
				<h2 class="section-title">Nem todo dado empresarial deve sair da sua infraestrutura.</h2>
				<p class="section-sub">
					Em projetos que exigem maior controle, avaliamos arquiteturas com modelos executados em ambientes
					próprios — como opção, não como solução universal.
				</p>
			</div>
			<div class="deploy-grid">
				<article class="card deploy-card">
					<span class="deploy-badge deploy-badge-cloud">Cloud AI</span>
					<p>Provedores externos e APIs de modelos, quando latência e custo importam mais e os dados podem ir à nuvem.</p>
				</article>
				<article class="card deploy-card">
					<span class="deploy-badge deploy-badge-local">Private AI</span>
					<p>Modelos locais, GPU própria e RAG privado para projetos que exigem soberania de dados.</p>
				</article>
			</div>
		</div>
	</section>

	<section id="faq" class="section section-alt">
		<div class="container">
			<div class="section-head">
				<p class="eyebrow">FAQ</p>
				<h2 class="section-title">Perguntas e respostas honestas</h2>
			</div>
			<dl class="faq-list">
				{faq.map((item) => (
					<div class="faq-item">
						<dt>{item.q}</dt>
						<dd>{item.a}</dd>
					</div>
				))}
			</dl>
		</div>
	</section>

	<section id="demo" class="section">
		<div class="container">
			<div class="cta-band">
				<p class="eyebrow">Demonstração</p>
				<h2 class="section-title">Solicitar demonstração</h2>
				<p class="section-sub">
					Transformamos processos complexos em software inteligente, automatizado e mensurável.
				</p>
				<div class="contact-actions">
					<a class="btn btn-primary btn-lg" href={whatsappLink} target="_blank" rel="noopener">
						Quero conversar
					</a>
					<a class="btn btn-secondary btn-lg" href={`mailto:${email}`}>Falar por e-mail</a>
				</div>
			</div>
		</div>
	</section>
</Layout>

<style>
	@keyframes float {
		0%,
		100% {
			transform: translateY(0);
		}
		50% {
			transform: translateY(-8px);
		}
	}

	.eyebrow-dot {
		width: 8px;
		height: 8px;
		border-radius: 50%;
		background: var(--grad);
	}

	/* Hero */
	.hero {
		position: relative;
		overflow: hidden;
		padding: 96px 0 104px;
		border-bottom: 1px solid var(--border);
	}

	.hero-bg {
		position: absolute;
		inset: 0;
		background:
			radial-gradient(52% 60% at 16% 8%, rgba(79, 70, 229, 0.14), transparent 72%),
			radial-gradient(44% 56% at 86% 20%, rgba(8, 145, 178, 0.12), transparent 70%),
			linear-gradient(180deg, #f8faff, var(--bg-0) 80%);
		pointer-events: none;
	}

	.hero-bg::after {
		content: '';
		position: absolute;
		inset: 0;
		background-image: linear-gradient(var(--border) 1px, transparent 1px),
			linear-gradient(90deg, var(--border) 1px, transparent 1px);
		background-size: 46px 46px;
		opacity: 0.5;
		-webkit-mask-image: radial-gradient(70% 70% at 50% 0%, #000 30%, transparent 82%);
